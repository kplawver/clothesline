{
  "description": "Capture visible Claude Code prompts and final replies only in explicitly enabled projects",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "clothesline",
            "args": ["capture-claude", "--hook"],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "clothesline",
            "args": ["capture-claude", "--hook"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
